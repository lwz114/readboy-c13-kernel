				phandle = <0xf9>;

				tsif2_sync {
					pins = "gpio96";
					function = "tsif2_sync";
					drive_strength = <0x02>;
					bias-pull-down;
				};
			};

			ap2mdm {

				ap2mdm_active {

					mux {
						pins = "gpio107", "gpio109", "gpio111";
						function = "gpio";
					};

					config {
						pins = "gpio107", "gpio109", "gpio111";
						drive-strength = <0x10>;
						bias-disable;
					};
				};

				ap2mdm_sleep {

					mux {
						pins = "gpio107", "gpio109", "gpio111";
						function = "gpio";
					};

					config {
						pins = "gpio107", "gpio109", "gpio111";
						drive-strength = <0x08>;
						bias-disable;
					};
				};
			};

			mdm2ap {

				mdm2ap_active {

					mux {
						pins = "gpio106", "gpio108", "gpio112";
						function = "gpio";
					};

					config {
						pins = "gpio106", "gpio108", "gpio112";
						drive-strength = <0x08>;
						bias-disable;
					};
				};

				mdm2ap_sleep {

					mux {
						pins = "gpio106", "gpio108", "gpio112";
						function = "gpio";
					};

					config {
						pins = "gpio106", "gpio108", "gpio112";
