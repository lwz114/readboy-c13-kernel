				qcom,mdss-dsi-off-command = [39 01 00 00 00 00 04 b9 83 10 2e 39 01 00 00 00 00 12 b1 10 fa af af 31 31 b1 00 31 36 36 36 36 22 21 15 00 05 01 00 00 0a 00 02 28 00 05 01 00 00 78 00 02 10 00];
