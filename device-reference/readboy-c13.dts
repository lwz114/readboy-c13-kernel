/dts-v1/;

/ {
	#address-cells = <0x02>;
	#size-cells = <0x02>;
	model = "Qualcomm Technologies, Inc. MSM 8996 v3 + PMI8996 MTP";
	compatible = "qcom,msm8996-mtp", "qcom,msm8996", "qcom,mtp";
	qcom,msm-id = <0xf6 0x30001>;
	qcom,pmic-id = <0x20009 0x10013 0x00 0x00>;
	interrupt-parent = <0x01>;
	qcom,board-id = <0x08 0x00>;

	cpus {
		#address-cells = <0x02>;
		#size-cells = <0x00>;

		cpu@0 {
			device_type = "cpu";
			compatible = "qcom,kryo";
			reg = <0x00 0x00>;
			qcom,limits-info = <0x02>;
			enable-method = "psci";
			qcom,ea = <0x03>;
			next-level-cache = <0x04>;
			linux,phandle = <0x0c>;
			phandle = <0x0c>;

			l2-cache {
				compatible = "arm,arch-cache";
				cache-level = <0x02>;
				qcom,dump-size = <0x88000>;
				linux,phandle = <0x04>;
				phandle = <0x04>;
			};

			l1-dcache {
				compatible = "arm,arch-cache";
				qcom,dump-size = <0x7800>;
				linux,phandle = <0x158>;
				phandle = <0x158>;
			};

			l1-tlb {
				qcom,dump-size = <0x2800>;
				linux,phandle = <0x15c>;
				phandle = <0x15c>;
			};
		};

		cpu@1 {
			device_type = "cpu";
			compatible = "qcom,kryo";
			reg = <0x00 0x01>;
			qcom,limits-info = <0x05>;
			enable-method = "psci";
			qcom,ea = <0x06>;
			next-level-cache = <0x04>;
			linux,phandle = <0x0d>;
			phandle = <0x0d>;

			l1-dcache {
				compatible = "arm,arch-cache";
				qcom,dump-size = <0x7800>;
				linux,phandle = <0x159>;
				phandle = <0x159>;
			};

			l1-tlb {
				qcom,dump-size = <0x2800>;
				linux,phandle = <0x15d>;
				phandle = <0x15d>;
			};
		};

		cpu@100 {
			device_type = "cpu";
			compatible = "qcom,kryo";
			reg = <0x00 0x100>;
			qcom,limits-info = <0x07>;
			enable-method = "psci";
			qcom,ea = <0x08>;
			next-level-cache = <0x09>;
			linux,phandle = <0x0e>;
			phandle = <0x0e>;

			l2-cache {
				compatible = "arm,arch-cache";
				cache-level = <0x02>;
				qcom,dump-size = <0x110000>;
				linux,phandle = <0x09>;
				phandle = <0x09>;
			};

			l1-dcache {
				compatible = "arm,arch-cache";
				qcom,dump-size = <0x7800>;
				linux,phandle = <0x15a>;
				phandle = <0x15a>;
			};

			l1-tlb {
				qcom,dump-size = <0x2800>;
				linux,phandle = <0x15e>;
				phandle = <0x15e>;
			};
		};

		cpu@101 {
			device_type = "cpu";
			compatible = "qcom,kryo";
			reg = <0x00 0x101>;
			enable-method = "psci";
			qcom,limits-info = <0x0a>;
			qcom,ea = <0x0b>;
			next-level-cache = <0x09>;
			linux,phandle = <0x0f>;
			phandle = <0x0f>;

			l1-dcache {
				compatible = "arm,arch-cache";
				qcom,dump-size = <0x7800>;
				linux,phandle = <0x15b>;
				phandle = <0x15b>;
			};

			l1-tlb {
				qcom,dump-size = <0x2800>;
				linux,phandle = <0x15f>;
				phandle = <0x15f>;
			};
		};

		cpu-map {

			cluster0 {

				core0 {
					cpu = <0x0c>;
				};

				core1 {
					cpu = <0x0d>;
				};
			};

			cluster1 {

				core0 {
					cpu = <0x0e>;
				};

				core1 {
					cpu = <0x0f>;
				};
			};
		};
	};

	soc {
		#address-cells = <0x01>;
		#size-cells = <0x01>;
		ranges = <0x00 0x00 0x00 0xffffffff>;
		compatible = "simple-bus";

		qcom,ion {
			compatible = "qcom,msm-ion";
			#address-cells = <0x01>;
			#size-cells = <0x00>;

			qcom,ion-heap@25 {
				reg = <0x19>;
				qcom,ion-heap-type = "SYSTEM";
			};

			qcom,ion-heap@22 {
				reg = <0x16>;
				memory-region = <0x10>;
				qcom,ion-heap-type = "DMA";
			};

			qcom,ion-heap@27 {
				reg = <0x1b>;
				memory-region = <0x11>;
				qcom,ion-heap-type = "DMA";
			};

			qcom,ion-heap@10 {
				reg = <0x0a>;
				memory-region = <0x12>;
				qcom,ion-heap-type = "HYP_CMA";
			};

			qcom,ion-heap@9 {
				reg = <0x09>;
				qcom,ion-heap-type = "SYSTEM_SECURE";
			};
		};

		qcom,mdss_mdp@900000 {
			compatible = "qcom,mdss_mdp";
			reg = <0x900000 0x90000 0x9b0000 0x1040 0x9b8000 0x1040>;
			reg-names = "mdp_phys", "vbif_phys", "vbif_nrt_phys";
			interrupts = <0x00 0x53 0x00>;
			vdd-supply = <0x13>;
			#address-cells = <0x01>;
			#size-cells = <0x01>;
			qcom,msm-bus,name = "mdss_mdp";
			qcom,msm-bus,num-cases = <0x03>;
			qcom,msm-bus,num-paths = <0x03>;
			qcom,msm-bus,vectors-KBps = <0x16 0x200 0x00 0x00 0x17 0x200 0x00 0x00 0x19 0x200 0x00 0x00 0x16 0x200 0x00 0x61a800 0x17 0x200 0x00 0x61a800 0x19 0x200 0x00 0x61a800 0x16 0x200 0x00 0x61a800 0x17 0x200 0x00 0x61a800 0x19 0x200 0x00 0x61a800>;
			qcom,mdss-num-nrt-paths = <0x01>;
			qcom,mdss-ab-factor = <0x01 0x01>;
			qcom,mdss-ib-factor = <0x01 0x01>;
			qcom,mdss-clk-factor = <0x69 0x64>;
			qcom,max-mixer-width = <0xa00>;
			qcom,max-pipe-width = <0xa00>;
			qcom,mdss-vbif-qos-rt-setting = <0x01 0x02 0x02 0x02>;
			qcom,mdss-vbif-qos-nrt-setting = <0x01 0x01 0x01 0x01>;
			qcom,mdss-has-panic-ctrl;
			qcom,mdss-per-pipe-panic-luts = <0x0f 0xffff 0xfffc 0xff00>;
			qcom,mdss-mdp-reg-offset = <0x1000>;
			qcom,max-bandwidth-low-kbps = <0x927c00>;
			qcom,max-bandwidth-high-kbps = <0x927c00>;
			qcom,max-bandwidth-per-pipe-kbps = <0x44aa20>;
			qcom,max-clk-rate = <0x18964020>;
			qcom,mdss-default-ot-rd-limit = <0x20>;
			qcom,mdss-default-ot-wr-limit = <0x10>;
			qcom,mdss-dram-channels = <0x02>;
			qcom,mdss-pipe-vig-off = <0x5000 0x7000 0x9000 0xb000>;
			qcom,mdss-pipe-rgb-off = <0x15000 0x17000 0x19000 0x1b000>;
			qcom,mdss-pipe-dma-off = <0x25000 0x27000>;
			qcom,mdss-pipe-cursor-off = <0x35000 0x37000>;
			qcom,mdss-pipe-vig-xin-id = <0x00 0x04 0x08 0x0c>;
			qcom,mdss-pipe-rgb-xin-id = <0x01 0x05 0x09 0x0d>;
			qcom,mdss-pipe-dma-xin-id = <0x02 0x0a>;
			qcom,mdss-pipe-cursor-xin-id = <0x07 0x07>;
			qcom,mdss-pipe-vig-clk-ctrl-offsets = <0x2ac 0x00 0x00 0x2b4 0x00 0x00 0x2bc 0x00 0x00 0x2c4 0x00 0x00>;
			qcom,mdss-pipe-rgb-clk-ctrl-offsets = <0x2ac 0x04 0x08 0x2b4 0x04 0x08 0x2bc 0x04 0x08 0x2c4 0x04 0x08>;
			qcom,mdss-pipe-dma-clk-ctrl-offsets = <0x2ac 0x08 0x0c 0x2b4 0x08 0x0c>;
			qcom,mdss-pipe-cursor-clk-ctrl-offsets = <0x3a8 0x10 0x0f 0x3b0 0x10 0x0f>;
			qcom,mdss-ctl-off = <0x2000 0x2200 0x2400 0x2600 0x2800>;
			qcom,mdss-mixer-intf-off = <0x45000 0x46000 0x47000 0x4a000>;
			qcom,mdss-mixer-wb-off = <0x48000 0x49000>;
			qcom,mdss-dspp-off = <0x55000 0x57000>;
			qcom,mdss-wb-off = <0x65000 0x65800 0x66000>;
			qcom,mdss-intf-off = <0x6b000 0x6b800 0x6c000 0x6c800>;
			qcom,mdss-pingpong-off = <0x71000 0x71800 0x72000 0x72800>;
			qcom,mdss-slave-pingpong-off = "", "\a0";
			qcom,mdss-ppb-ctl-off = <0x330 0x338>;
			qcom,mdss-ppb-cfg-off = <0x334 0x33c>;
			qcom,mdss-has-pingpong-split;
			qcom,mdss-ad-off = <0x79000 0x79800 0x7a000>;
			qcom,mdss-cdm-off = <0x7a200>;
			qcom,mdss-dsc-off = <0x81000 0x81400>;
			qcom,mdss-wfd-mode = "intf";
			qcom,mdss-has-source-split;
			qcom,mdss-highest-bank-bit = <0x02>;
			qcom,mdss-has-decimation;
			qcom,mdss-has-rotator-downscale;
			qcom,mdss-idle-power-collapse-enabled;
			clocks = <0x14 0x684ccb41 0x14 0xcc07d687 0x14 0x6dc1f8f1 0x14 0x588460a4 0x14 0x42a022d3>;
			clock-names = "iface_clk", "bus_clk", "core_clk_src", "core_clk", "vsync_clk";
			qcom,mdp-settings = <0x12ac 0xc0000ccc 0x12b4 0xc0000ccc 0x12bc 0xcccccc 0x12c4 0xcc 0x13a8 0xcccc0c0 0x13b0 0xccccc0c0 0x13b8 0xcccc0000 0x13d0 0xcc0000 0x506c 0x00 0x706c 0x00 0x906c 0x00 0xb06c 0x00 0x1506c 0x00 0x1706c 0x00 0x1906c 0x00 0x1b06c 0x00 0x2506c 0x00 0x2706c 0x00>;
			qcom,regs-dump-mdp = <0x1000 0x1454 0x2000 0x2064 0x2200 0x2264 0x2400 0x2464 0x2600 0x2664 0x2800 0x2864 0x5000 0x5150 0x5200 0x5230 0x7000 0x7150 0x7200 0x7230 0x9000 0x9150 0x9200 0x9230 0xb000 0xb150 0xb200 0xb230 0x15000 0x15150 0x15200 0x15230 0x17000 0x17150 0x17200 0x17230 0x19000 0x19150 0x19200 0x19230 0x1b000 0x1b150 0x1b200 0x1b230 0x25000 0x25150 0x27000 0x27150 0x35000 0x35150 0x37000 0x37150 0x45000 0x452bc 0x46000 0x462bc 0x47000 0x472bc 0x48000 0x482bc 0x49000 0x492bc 0x4a000 0x4a2bc 0x55000 0x5522c 0x57000 0x5722c 0x65000 0x652c0 0x65800 0x65ac0 0x66000 0x662c0 0x6b800 0x6ba68 0x6c000 0x6c268 0x6c800 0x6ca68 0x71000 0x710d4 0x71800 0x718d4 0x73000 0x730d4 0x81000 0x81140 0x81400 0x81540>;
			qcom,regs-dump-names-mdp = "MDP", "CTL_0", "CTL_1", "CTL_2", "CTL_3", "CTL_4", "VIG0_SSPP", "VIG0", "VIG1_SSPP", "VIG1", "VIG2_SSPP", "VIG2", "VIG3_SSPP", "VIG3", "RGB0_SSPP", "RGB0", "RGB1_SSPP", "RGB1", "RGB2_SSPP", "RGB2", "RGB3_SSPP", "RGB3", "DMA0_SSPP", "DMA1_SSPP", "CURSOR0_SSPP", "CURSOR1_SSPP", "LAYER_0", "LAYER_1", "LAYER_2", "LAYER_3", "LAYER_4", "LAYER_5", "DSPP_0", "DSPP_1", "WB_0", "WB_1", "WB_2", "INTF_1", "INTF_2", "INTF_3", "PP_0", "PP_1", "PP_4", "DSC_0", "DSC_1";
			qcom,regs-dump-xin-id-mdp = <0xff 0xff 0xff 0xff 0xff 0xff 0x00 0x00 0x04 0x04 0x08 0x08 0x0c 0x0c 0x01 0x01 0x05 0x05 0x09 0x09 0x0d 0x0d 0x02 0x0a 0x07 0x07 0xff 0xff 0xff 0xff 0xff 0xff 0xff 0xff 0x03 0x0b 0x06>;
			qcom,mdss-prefill-outstanding-buffer-bytes = <0x00>;
			qcom,mdss-prefill-y-buffer-bytes = <0x00>;
			qcom,mdss-prefill-scaler-buffer-lines-bilinear = <0x02>;
			qcom,mdss-prefill-scaler-buffer-lines-caf = <0x04>;
			qcom,mdss-prefill-post-scaler-buffer-pixels = <0xa00>;
			qcom,mdss-prefill-pingpong-buffer-pixels = <0x1400>;
			qcom,mdss-pref-prim-intf = "dsi";
			linux,phandle = <0x25>;
			phandle = <0x25>;

			qcom,mdss-pp-offsets {
				qcom,mdss-sspp-mdss-igc-lut-off = <0x2000>;
				qcom,mdss-sspp-vig-pcc-off = <0x1780>;
				qcom,mdss-sspp-rgb-pcc-off = <0x380>;
				qcom,mdss-sspp-dma-pcc-off = <0x380>;
				qcom,mdss-lm-pgc-off = <0x3c0>;
				qcom,mdss-dspp-gamut-off = <0x1600>;
				qcom,mdss-dspp-pcc-off = <0x1700>;
				qcom,mdss-dspp-pgc-off = <0x17c0>;
			};

			qcom,smmu_mdp_unsec_cb {
				compatible = "qcom,smmu_mdp_unsec";
				iommus = <0x15 0x00>;
				reg = <0xd08000 0xd00>;
				reg-names = "mmu_cb";
				gdsc-mmagic-mdss-supply = <0x16>;
				clocks = <0x14 0x4994cb2 0x14 0xa0359d10 0x14 0x7fd71687>;
				clock-names = "mdp_ahb_clk", "mmagic_mdss_axi_clk", "mdp_axi_clk";
			};

			qcom,smmu_rot_unsec_cb {
				compatible = "qcom,smmu_rot_unsec";
				iommus = <0x17 0x00>;
				reg = <0xd09000 0xd00>;
				reg-names = "mmu_cb";
				gdsc-mmagic-mdss-supply = <0x16>;
				clocks = <0x14 0xa30772c9 0x14 0xa0359d10 0x14 0xfed7c078>;
				clock-names = "rot_ahb_clk", "mmagic_mdss_axi_clk", "rot_axi_clk";
			};

			qcom,smmu_mdp_sec_cb {
				compatible = "qcom,smmu_mdp_sec";
				iommus = <0x15 0x01>;
				reg = <0xd0a000 0xd00>;
				reg-names = "mmu_cb";
				gdsc-mmagic-mdss-supply = <0x16>;
				clocks = <0x14 0x4994cb2 0x14 0xa0359d10 0x14 0x7fd71687>;
				clock-names = "mdp_ahb_clk", "mmagic_mdss_axi_clk", "mdp_axi_clk";
			};

			qcom,smmu_rot_sec_cb {
				compatible = "qcom,smmu_rot_sec";
				iommus = <0x17 0x01>;
				reg = <0xd0b000 0xd00>;
				reg-names = "mmu_cb";
				gdsc-mmagic-mdss-supply = <0x16>;
				clocks = <0x14 0xa30772c9 0x14 0xa0359d10 0x14 0xfed7c078>;
				clock-names = "rot_ahb_clk", "mmagic_mdss_axi_clk", "rot_axi_clk";
			};

			qcom,mdss_fb_primary {
				cell-index = <0x00>;
				compatible = "qcom,mdss-fb";
				linux,phandle = <0x1f>;
				phandle = <0x1f>;

				qcom,cont-splash-memory {
					linux,contiguous-region = <0x18>;
				};
			};

			qcom,mdss_fb_wfd {
				cell-index = <0x01>;
				compatible = "qcom,mdss-fb";
				linux,phandle = <0x2e>;
				phandle = <0x2e>;
			};

			qcom,mdss_fb_hdmi {
				cell-index = <0x02>;
				compatible = "qcom,mdss-fb";
				linux,phandle = <0x30>;
				phandle = <0x30>;

				qcom,cont-splash-memory {
					linux,contiguous-region = <0x19>;
				};
			};

			qcom,mdss_fb_secondary {
				cell-index = <0x03>;
				compatible = "qcom,mdss-fb";
				linux,phandle = <0x20>;
				phandle = <0x20>;
			};

